<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <PackageId>Pmac.Russh</PackageId>
    <AssemblyName>Pmac.Russh</AssemblyName>
    <Version>2.0.7</Version>
    <Authors>sangmomo</Authors>
    <Description>Power PPMAC communication through the pmac native library</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://gitee.com/sangmomo/communication-library-for-ppmac-rust</PackageProjectUrl>
    <RepositoryUrl>https://gitee.com/sangmomo/communication-library-for-ppmac-rust.git</RepositoryUrl>
  </PropertyGroup>
</Project>
